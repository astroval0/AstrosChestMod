<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\modinfo.json')), '"version"\s*:\s*"([^"]+)"').Groups[1].Value)</Version>
        <VintageStoryDir>$(APPDATA)\Vintagestory</VintageStoryDir>
        <ModInstallDir>$(APPDATA)\VintagestoryData\Mods\AstrosChestMod</ModInstallDir>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="VintagestoryAPI">
            <HintPath>$(VintageStoryDir)\VintagestoryAPI.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <Reference Include="VSSurvivalMod">
            <HintPath>$(VintageStoryDir)\Mods\VSSurvivalMod.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <None Update="modinfo.json" CopyToOutputDirectory="PreserveNewest"/>
        <None Update="assets\**\*" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <Target Name="InstallMod" AfterTargets="Build">
        <ItemGroup>
            <ModAssets Include="$(TargetDir)assets\**\*"/>
        </ItemGroup>
        <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb;$(TargetDir)modinfo.json" DestinationFolder="$(ModInstallDir)"/>
        <Copy SourceFiles="@(ModAssets)" DestinationFolder="$(ModInstallDir)\assets\%(RecursiveDir)"/>
    </Target>

</Project>
